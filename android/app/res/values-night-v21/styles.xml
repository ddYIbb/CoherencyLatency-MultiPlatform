<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 5.0+ night variant: Material dark base so the system-drawn
         pieces (scrollbars, ripples, selection handles) match the dark UI. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0F1216</item>
        <item name="android:statusBarColor">#FF0F1216</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
